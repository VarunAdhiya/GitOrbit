# Copy to .env at the repository root. Never commit real credentials.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Local PostgreSQL; replace both URLs for Supabase (see docs/SETUP.md).
# DATABASE_URL can use Supabase's session pooler with a server-only role.
# DIRECT_URL must use a direct connection or session-mode pooler for migrations.
# Port 5433 avoids conflicts with an existing local PostgreSQL on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://gitorbit:gitorbit@localhost:5433/gitorbit
DIRECT_URL=postgresql://gitorbit:gitorbit@localhost:5433/gitorbit
REDIS_URL=redis://localhost:6379

# Required for profiles and resume analysis: Google sign-in via Supabase Auth.
# Configure Google in Supabase's dashboard; public browsing works without sign-in.
# Keep the Google Client Secret in Supabase, not in this repository.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required only for workers: server-side GitHub token with public repository read access.
GITHUB_TOKEN=
GITHUB_LANGUAGES=TypeScript,JavaScript,Python,Java,Go,Rust,C++
WORKER_CONCURRENCY=3
STALE_HOURS=48

# Groq API: paste your Groq key into LLM_API_KEY. No paid OpenAI key is needed.
# This Groq-hosted model supports strict JSON schema output. Free-tier limits apply.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_PROVIDER_NAME=Groq
PROFILE_TTL_HOURS=24

# Optional protected HTTP administration. Generate at least 32 random characters.
# Without this setting the admin endpoints deny all requests; the local CLI still works.
# ADMIN_TOKEN=
# Only increase behind a known trusted proxy, never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
