{
  "name": "gitorbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c green,blue,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:web": "npm run dev -w @gitorbit/web",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env apps/worker/src/main.ts",
    "start:api": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "start:worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "start:web": "npm run start -w @gitorbit/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "ingestion:schedule": "tsx --env-file-if-exists=.env apps/worker/src/cli.ts schedule",
    "ingestion:trigger": "tsx --env-file-if-exists=.env apps/worker/src/cli.ts trigger",
    "ingestion:health": "tsx --env-file-if-exists=.env apps/worker/src/cli.ts health",
    "typecheck": "tsc --noEmit && npm run typecheck -w @gitorbit/web",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown apps packages tests docs *.ts *.mjs *.json *.yml .github/workflows",
    "build": "npm run db:generate && npm run typecheck && npm run build -w @gitorbit/web",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/pipeline.integration.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "bullmq": "6.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "multer": "^2.0.2",
    "pdf-parse": "2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "rate-limit-redis": "^4.3.1",
    "tsx": "^4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
